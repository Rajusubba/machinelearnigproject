
{
  "family": "machinelearningproject",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "3072",
  "executionRoleArn": "arn:aws:iam::490841876782:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "studentperformance",
      "image": "490841876782.dkr.ecr.us-east-2.amazonaws.com/studentperformance:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/machinelearningproject",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}